# ==============================================================================
# ODACE TestOps - Environnement local de développement
# ==============================================================================

# API & Sécurité
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production-odace-testops-secret-key-32b
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://odace_app:odace_pass@localhost:5432/odace_testops

# Redis & Tâches
REDIS_URL=redis://localhost:6379/0

# MinIO (Stockage Objets S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ARTIFACTS=odace-artifacts
MINIO_SECURE=false

# Keycloak OIDC
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=odace
KEYCLOAK_CLIENT_ID=odace-platform

# Vault (Secrets)
VAULT_URL=http://localhost:8200
VAULT_TOKEN=root

# Cible factice
FAKE_TARGET_URL=http://localhost:8088
